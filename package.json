{
  "name": "kasugai-agent",
  "version": "0.2.0",
  "description": "課題自律ループ常駐エージェント（検出→評価→対応→実機検証→学習）",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/control.mjs",
    "dev": "cargo run --manifest-path server/Cargo.toml",
    "check": "node --check src/control.mjs && node --check src/acp-chat.mjs",
    "diagrams": "node tools/sync-diagrams.mjs",
    "diagrams:check": "node tools/sync-diagrams.mjs --check",
    "docs": "node tools/sync-docs.mjs",
    "docs:check": "node tools/sync-docs.mjs --check",
    "test": "node --test \"test/*.test.mjs\"",
    "dist": "node tools/make-dist.mjs"
  }
}
