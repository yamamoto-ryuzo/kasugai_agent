{
  "controlPort": 8586,
  "devinExe": "C:\\path\\to\\devin.exe",
  "devinExtraArgs": [],
  "chatAgent": "devin",
  "chatAgents": {
    "devin": {
      "label": "Devin",
      "type": "acp",
      "exe": "C:\\path\\to\\devin.exe",
      "args": [
        "acp"
      ],
      "auth": "devin"
    },
    "copilot": {
      "label": "Copilot CLI",
      "type": "acp",
      "exe": "copilot",
      "args": [
        "--acp"
      ],
      "auth": "none",
      "env": {
        "COPILOT_GITHUB_TOKEN": "secret:copilot-github-token"
      }
    },
    "hub-copilot": {
      "label": "Copilot (bridge-hub)",
      "type": "agent",
      "endpoint": "http://127.0.0.1:8511/agent",
      "provider": "copilot"
    },
    "local-llm": {
      "label": "Local LLM (OpenAI互換)",
      "type": "openai",
      "endpoint": "http://127.0.0.1:1234/v1",
      "model": "model-name"
    }
  },
  "chatStallMinutes": 30,
  "parallelMaxChildren": 4,
  "parallelMaxDepth": 1,
  "autoRestartOnDrift": true,
  "autoVerify": true,
  "autoResumeOnStart": true,
  "conflictWait": true,
  "heartbeatMinutes": 5,
  "detectorSilentMinutes": 30,
  "retryLimit": 3,
  "verifyBackLimit": 3,
  "verifyBackoffMinutes": 5,
  "verifyBackoffMaxMinutes": 60,
  "planGate": true,
  "autoApprovePlan": false,
  "planAutoApproveMinutes": 0,
  "planTimeoutMinutes": 30,
  "criticTimeoutMinutes": 15,
  "planCriticMinConfidence": 0.7,
  "diffReview": true,
  "diffReviewMinConfidence": 0.7,
  "diffReviewTimeoutMinutes": 15,
  "modelRouting": {
    "agents": {
      "light": "",
      "standard": "",
      "deep": ""
    },
    "criticTier": "light"
  },
  "codeMap": {
    "enabled": true,
    "maxUnits": 12,
    "maxBytes": 9000,
    "maxFiles": 2000,
    "maxFileBytes": 200000
  },
  "reproFirst": true,
  "remediations": [
    {
      "name": "retry",
      "backs": 3
    },
    {
      "name": "replan",
      "backs": 2
    },
    {
      "name": "human"
    }
  ],
  "postPushWatch": true,
  "postPushWatchMinutes": 120,
  "postPushMaxRepairs": 3,
  "intakeMaxPerHour": 0,
  "intakeCooldownMinutes": 60,
  "intakeCooldownBy": [
    "source",
    "repo",
    "kind"
  ],
  "inhibitRules": [
    {
      "cause": {
        "source": "ci-failure",
        "kind": "build"
      },
      "effect": {
        "source": "ci-failure",
        "kind": "test"
      },
      "match": [
        "repo"
      ]
    }
  ],
  "intakeObserveMinutes": 10,
  "intakeObserveMinHits": 2,
  "observingExempt": [
    "manual",
    "derived"
  ],
  "lessonHarmLimit": 2,
  "consolidateIdleMinutes": 30,
  "consolidateMinCluster": 3,
  "stormBatchMin": 5,
  "stormWindowMinutes": 10,
  "splitMaxBytes": 4000,
  "splitMaxItems": 8,
  "incidentWindowMinutes": 60,
  "runCycleCap": 3,
  "allowAutoLoop": false,
  "budgetMaxSteps": 2000,
  "budgetMaxWallMinutes": 0,
  "budgetMaxCostUsd": 0,
  "stuckDetect": true,
  "riskConfirm": true,
  "riskHighPatterns": [],
  "partialPreserve": true,
  "maxConcurrentRuns": 4,
  "issueExecMode": "parallel",
  "skillDirs": [
    ".agents/skills"
  ],
  "retentionDays": 0,
  "repos": [
    {
      "slug": "yamamoto-ryuzo/kasugai_agent",
      "path": "C:/devin/kasugai_agent",
      "requirePushApproval": false
    }
  ],
  "repoScanDirs": [
    "C:/Users/you/repos"
  ],
  "devEnvironments": [
    {
      "id": "example",
      "label": "Example dev env",
      "cwd": "C:/path/to/repo",
      "command": "cargo run",
      "port": 8000,
      "url": "http://127.0.0.1:8000/"
    }
  ],
  "pollSeconds": {
    "issues": 120,
    "health": 300,
    "learn": 60,
    "postPush": 300
  },
  "cdnBaseUrl": "",
  "cdnCheckMinutes": 0,
  "cdnManifestSha256": "",
  "assetAutoApply": {
    "panel": true,
    "docs": true,
    "prompts": false
  }
}